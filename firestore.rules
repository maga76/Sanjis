rules_version = '2';

// Правила доступа к базе Sanjish.
// Вставляются в Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Админ — эти почты, подтверждённые (вход через Google).
    // Тот же список — kAdminEmails в lib/features/auth/application/auth_service.dart
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['safarov.m.9911@gmail.com'];
    }

    // Профиль ученика: свой — читать и менять, админ — читать все.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Пройденные тесты: только добавлять свои, менять нельзя.
      match /attempts/{attemptId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Статистика админа по всем ученикам.
    match /{path=**}/attempts/{attemptId} {
      allow read: if isAdmin();
    }

    // Темы, вопросы и удалённые демо-вопросы: читают все ученики,
    // меняет только админ.
    match /topics/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /deleted/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Счётчики ответов по вопросам: ученики только увеличивают,
    // читает админ.
    match /questionStats/{questionId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['asked', 'wrong']);
      allow delete: if false;
    }
  }
}
